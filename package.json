{
  "name": "neuroclarity-mobile",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:native": "expo export --platform android --platform ios --output-dir dist/native",
    "test:e2e": "playwright test",
    "android:apk": "node scripts/build-android.mjs"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4"
  },
  "description": "NeuroClarity doctor companion for Android and iOS",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
